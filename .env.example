# Browser-visible origins used in metadata and WebSocket routing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional. Development defaults to ws://<current-host>:3001/ws.
# NEXT_PUBLIC_WS_URL=wss://games.example.com/ws
# GitHub Pages builds read NEXT_PUBLIC_WS_URL from the repository Actions variable
# with the same name. It must use wss:// in production.

# Authoritative WebSocket service.
WS_PORT=3001
# Comma-separated exact origins. Leave unset during local development.
# ALLOWED_ORIGINS=https://games.example.com
